{
  "productName": "Publii",
  "name": "Publii",
  "version": "0.48.3",
  "description": "Static Site CMS",
  "homepage": "https://getpublii.com",
  "author": {
    "name": "TidyCustoms",
    "email": "bob@tidycustoms.net"
  },
  "license": "GPL-3.0",
  "main": "app/main.js",
  "scripts": {
    "dev": "webpack --node-env=development --mode=development --progress --watch",
    "prod": "webpack --node-env=production --mode=production --progress",
    "build": "node ./build/scripts/update-build-number.js && electron app/",
    "build2": "electron app/",
    "notarize": "xcrun notarytool submit ./dist/$npm_config_file --keychain-profile 'Publii' --wait",
    "start": "electron app/main.js --enable-logging",
    "pretest": "node build/scripts/check-test-runtime.js",
    "test": "npm run audit:design-system && mocha \"build/scripts/specs/**/*.spec.js\" \"app/back-end/**/*.spec.js\" \"app/src/helpers/specs/**/*.spec.js\" \"app/src/components/specs/**/*.spec.js\" --reporter spec",
    "audit:design-system": "node build/scripts/audit-design-system.js",
    "licenses": "node build/scripts/generate-licenses.js",
    "licenses:check": "node build/scripts/generate-licenses.js --check",
    "prepare-editor": "node build/scripts/prepare-editor.js",
    "prepare-editor:win": "npm run prepare-editor",
    "prepare-editor-css": "node build/scripts/prepare-editor-css.js",
    "packager:win": "electron-builder build --win --x64",
    "packager:mac-intel": "electron-builder build --mac",
    "packager:mac-m": "electron-builder build --mac --arm64",
    "packager:linux": "electron-builder build --linux"
  },
  "repository": {
    "url": "https://github.com/GetPublii/Publii/"
  },
  "bugs": {
    "url": "https://github.com/GetPublii/Publii/issues"
  },
  "keywords": [],
  "devDependencies": {
    "css-loader": "6.8.1",
    "electron": "43.8.7",
    "electron-builder": "26.15.3",
    "mocha": "10.2.0",
    "node-abi": "4.35.0",
    "node-gyp": "12.2.0",
    "postcss": "8.4.31",
    "vue-loader": "15.11.1",
    "vue-style-loader": "4.1.3",
    "vue-template-compiler": "2.6.14",
    "webpack": "5.89.0",
    "webpack-cli": "5.1.4"
  },
  "build": {
    "appId": "com.tidycustoms.publii",
    "electronVersion": "43.8.7",
    "productName": "Publii",
    "copyright": "Copyright (C) 2016-2026 TidyCustoms. All rights reserved.",
    "asar": true,
    "toolsets": {
      "appimage": "1.0.2"
    },
    "asarUnpack": [
      "*.+(dylib|node|dll|aff|dic)",
      "default-files/default-themes/**/*",
      "default-files/default-languages/**/*",
      "default-files/gdpr-assets/**/*",
      "default-files/vendor/**/*",
      "licenses/LICENSES.chromium.html",
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*",
      "**/node_modules/@jsquash/**/*",
      "node_modules/@napi-rs/**/*"
    ],
    "beforeBuild": "./build/scripts/beforeBuild.js",
    "afterPack": "./build/scripts/afterPack.js",
    "files": [
      "**/*",
      "dist/**/*",
      "!app/node_modules/devtron/**/*",
      "!app/node_modules/accessibility-developer-tools/**/*",
      "!app/node_modules/babel*",
      "!app/node_modules/postcss*",
      "!app/node_modules/asn1/**/*",
      "!app/node_modules/electron-*",
      "app/node_modules/publii-block-editor"
    ],
    "linux": {
      "icon": "./build/installation/icons",
      "target": [
        "rpm",
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "description": "Static Site CMS",
      "executableName": "Publii",
      "syncDesktopName": true
    },
    "win": {
      "icon": "build/installation/icon.ico",
      "target": "nsis"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/installation/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "minimumSystemVersion": "12.0"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": "always"
    },
    "dmg": {
      "sign": false,
      "icon": "build/installation/volume.icns",
      "title": "Install Publii"
    }
  }
}
